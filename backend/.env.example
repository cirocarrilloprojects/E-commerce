
# ─────────────────────────────────────────────────────────────
# Copia este archivo a ".env" y completa los valores.
# NUNCA subas ".env" a Git (ya está en .gitignore).
# Todas estas variables las valida src/config/env.js al arrancar.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Cantidad de proxies de confianza delante de la API (0 = ninguno, 1 = Render/Railway/Nginx).
TRUST_PROXY=0

# UNA sola URI de Mongo (antes eran 4 variables). Si la clave tiene caracteres
# especiales (@ : / ?) debes codificarla (URL-encode) dentro de la URI.
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.i5tm2it.mongodb.net/<base_de_datos>?appName=Cluster0

# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=3dac095593852cb75d049e73023949d67c659d625c6c2cf3de1fa5834c6397cf78b3c8ccdd8a0f47a8523bf56b7d91fb

# Origen EXACTO del frontend (sin barra final). Lo usan CORS, la verificación de Origin y las back_urls de pago.
FRONTEND_URL=http://localhost:5173

# URL PÚBLICA de este backend (Mercado Pago llama a  BACKEND_URL/api/webhook).
# En local necesitas un túnel (ngrok, cloudflared...) porque MP no puede llamar a localhost.
BACKEND_URL=http://localhost:3000

# lax | strict | none.  "none" solo si front y API están en dominios distintos Y NODE_ENV=production (HTTPS).
COOKIE_SAMESITE=lax

# Credenciales de Mercado Pago (Tus integraciones → tu aplicación)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_de_mercadopago

# Moneda de tu cuenta de Mercado Pago (ISO 4217): COP, ARS, MXN, CLP, PEN, UYU, BRL...
MP_CURRENCY_ID=COP

# Solo para "npm run seed:admin" (crea/promueve el administrador)
ADMIN_EMAIL=admin@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123